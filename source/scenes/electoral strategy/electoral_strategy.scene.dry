    [+ saskatoon_contests +]
</div>

<div style="display:flex;align-items:center;gap:8px;margin:5px 0;flex-wrap:wrap">
    <span>Moose Jaw ([+ districts.moose_jaw.seats +] seats) : </span>
    [+ moose_jaw_contests +]
</div>

[? if districts.prince_albert.seats >= 0 : {!
    <div style="display:flex;align-items:center;gap:8px;margin:5px 0;flex-wrap:wrap">
    <span>Prince Albert !}([+ districts.prince_albert.seats +] seats){! : </span>
    !}[+ prince_albert_contests +]{!
  </div>
!}?]



- @full_slate: Let's run a Full Slate!
- @cps_strategy: What Electoral Options can we discuss with the Tories?
- @scps_strategy: Will Social Credit discuss Electoral Strategy with us?
- @cpc_s_strategy: The Communists may be willing to help us...
- @electoral_strategy_finished: We have finished our electoral preparations!

@full_slate
title: Let's run a Full Slate
unavailable-subtitle: We should cancel our inter-party plans if we plan to full slate
on-arrival: {!
    Object.keys(Q.districts).forEach(district => {
        Q[district + '_ccf_rcr'] = 1; 
    });
!}
choose-if: cps_cooperation = 0 and scps_cooperation = 0 and cpc_s_cooperation = 0

@cps_strategy
unavailable-subtitle: They are not willing to entertain cooperation with us
choose-if: cps_relation >= 50
on-arrival: cps_election_planning = 1;

@scps_strategy
unavailable-subtitle: They are not willing to entertain cooperation with us
choose-if: scps_relation >= 70
on-arrival: scps_election_planning = 1;

@cpc_s_strategy
unavailable-subtitle: They are not willing to entertain cooperation with us
choose-if: cpc_s_relation >= 60
on-arrival: cpc_s_election_planning = 1;

@electoral_strategy_finished
