title: Legislative Election
new-page: true
tags: event
priority: -1
view-if: (year = next_parl_election_year and month >= next_parl_election_month) or (year > next_parl_election_year)
on-departure: month_actions += 1; in_election = 0; next_parl_election_year = next_parl_election_year + 4; n_elections += 1; next_election_time = time + 60; papen_premier_timer = 4;
set-jump: post_election
face-image: img/Rothe_Wahlen_1903.jpg




# TODO: should there be an image?

# the low priority means that this event is only seen after all other events are resolved for the month.

= Elections, [+ month : month +] [+ year +]

The Legislative elections are to be held now.

- @election_algorithm_sk: May we do our best...


@election_algorithm_sk
on-arrival: {!


// Lots of this election code taken from the Beeshana Kelaya mod...

Q.district_results_legislative = [];
Q.use_decimals = 1;

// ----------------------------------------------
// SAVE PREVIOUS RESULTS
// ----------------------------------------------

for (var party of Q.parties) {
    Q["old_" + party + "_seats"] = Q[party + "_seats"];
    Q["old_" + party + "_polls"] = Q[party + "_polls"];
}


// ----------------------------------------------
// BUILD NESTED ELECTION GROUPS
// Regional demographics + group adjustments
// ----------------------------------------------

var electionGroups = [];
var groupsByRegion = {};

for (var regionName in Q.districts) {
    var regionData = Q.districts[regionName];

    groupsByRegion[regionName] = [];

    var baseline = regionData.demographics || regionData;
    var constituencies = regionData.constituencies || {};
    var constituencyNames = Object.keys(constituencies);

    // Use nested groups if present.
    if (constituencyNames.length > 0) {

        for (var constituencyName of constituencyNames) {
            var constituency = constituencies[constituencyName];

            var seats = Math.max(
                0,
                Math.floor(Number(constituency.seats) || 0)
            );

            if (seats <= 0) continue;

            var demographics = {};
            var adjustments = constituency.adjustments || {};

            for (var c of Q.classes) {
                demographics[c] =
                    (Number(baseline[c]) || 0) +
                    (Number(adjustments[c]) || 0);
            }

            var group = {
                region: regionName,
                name: constituencyName,
                key: constituencyName,
                seats: seats,
                demographics: demographics,
                results: {}
            };

            electionGroups.push(group);
            groupsByRegion[regionName].push(group);
        }

    } else {
        // Backward compatibility for regions without nested groups.
        var seats = Math.max(
            0,
            Math.floor(Number(regionData.seats) || 0)
        );

        if (seats <= 0) continue;

        var demographics = {};

        for (var c of Q.classes) {
            demographics[c] = Number(baseline[c]) || 0;
        }

        var group = {
            region: regionName,
            name: regionName,
            key: regionName,
            seats: seats,
            demographics: demographics,
            results: {}
        };

        electionGroups.push(group);
        groupsByRegion[regionName].push(group);
    }
}


// ----------------------------------------------
// CLASS POPULATION CALCULATIONS
// Weight demographic profiles by represented seats
// ----------------------------------------------

Q.total_population = 0;

for (var c of Q.classes) {
    Q[c + "_total_population"] = 0;
}

for (var group of electionGroups) {
    for (var c of Q.classes) {
        Q[c + "_total_population"] +=
            group.demographics[c] * group.seats;
    }
}

for (var c of Q.classes) {
    Q.total_population += Q[c + "_total_population"];
}

for (var c of Q.classes) {
    Q[c + "_population_percent"] =
        Q.total_population > 0
            ? 100 * Q[c + "_total_population"] / Q.total_population
            : 0;

    console.log(
        c + " population percent: " + Q[c + "_population_percent"]
    );
}


// ----------------------------------------------
// NORMALIZE CLASS VOTING SHARES
// ----------------------------------------------

for (var c of Q.classes) {
    var class_polls = 0;

    for (var party of Q.parties) {
        if (Q[c + "_" + party] < 0) {
            Q[c + "_" + party] = 0;
        }

        class_polls += Number(Q[c + "_" + party]) || 0;
    }

    for (var party of Q.parties) {
        Q[c + "_" + party + "_normalized"] =
            class_polls > 0
                ? (Number(Q[c + "_" + party]) || 0) / class_polls
                : 0;
    }
}


// ----------------------------------------------
// RESET ELECTION COUNTS
// ----------------------------------------------

for (var party of Q.parties) {
    Q[party + "_seats"] = 0;
    Q[party + "_contests"] = 0;
    Q[party + "_raw_polls"] = 0;
    Q[party + "_contested_votes"] = 0;
    Q[party + "_national_votes"] = 0;
}

Q._total_votes_all_seats = 0;

for (var regionName in Q.districts) {
    var regionSeats = (groupsByRegion[regionName] || [])
        .reduce(function(total, group) {
            return total + group.seats;
        }, 0);

    Q[regionName + "_district_seats"] = regionSeats;

    for (var party of Q.parties) {
        Q[regionName + "_" + party + "_seats"] = 0;
    }
}


// ----------------------------------------------
// DISTRIBUTE EACH PARTY'S RCR ACROSS GROUPS
// Preserve the exact regional candidate total
// ----------------------------------------------

var groupCaps = {};

for (var group of electionGroups) {
    groupCaps[group.key] = {};
}

for (var regionName in Q.districts) {
    var regionGroups = groupsByRegion[regionName] || [];

    var regionSeats = regionGroups.reduce(function(total, group) {
        return total + group.seats;
    }, 0);

    for (var party of Q.parties) {
        var rawRCR =
            Q[regionName + "_" + party + "_rcr"] !== undefined
                ? Number(Q[regionName + "_" + party + "_rcr"])
                : 1;

        if (!Number.isFinite(rawRCR)) rawRCR = 1;

        var rcr = Math.max(0, Math.min(1, rawRCR));

        // The regional target is the exact number of candidates.
        var targetContests = Math.floor(regionSeats * rcr + 1e-9);

        // Initially distribute candidates proportionally.
        var plan = regionGroups.map(function(group) {
            var quota = group.seats * rcr;
            var floorQuota = Math.floor(quota);

            return {
                group: group,
                contested: floorQuota,
                remainder: quota - floorQuota
            };
        });

        var assigned = plan.reduce(function(total, entry) {
            return total + entry.contested;
        }, 0);

        // Distribute remaining candidates by largest remainder.
        var ranked = plan.slice().sort(function(a, b) {
            return (b.remainder - a.remainder) ||
                   a.group.name.localeCompare(b.group.name);
        });

        var remaining = targetContests - assigned;

        for (var i = 0; i < ranked.length && remaining > 0; i++) {
            if (ranked[i].contested < ranked[i].group.seats) {
                ranked[i].contested++;
                remaining--;
            }
        }

        for (var entry of plan) {
            groupCaps[entry.group.key][party] = entry.contested;
        }

        // Maintain the regional qualities used by your existing UI.
        Q[regionName + "_" + party + "_contested"] = targetContests;
        Q[party + "_contests"] += targetContests;
    }
}


// ----------------------------------------------
// SEAT ALLOCATION FUNCTION
// Retain your existing D'Hondt allocator
// ----------------------------------------------

function allocateSeats(votes, totalSeats, maxSeats) {
    var seats = {};

    for (var p in votes) {
        seats[p] = 0;
    }

    for (var s = 0; s < totalSeats; s++) {
        var maxQ = -1;
        var winner = null;

        for (var p in votes) {
            if (seats[p] >= maxSeats[p]) continue;

            var q = votes[p] / (seats[p] + 1);

            if (q > maxQ) {
                maxQ = q;
                winner = p;
            }
        }

        // Leave remaining seats vacant if no party has
        // any candidate capacity remaining.
        if (winner === null) break;

        seats[winner]++;
    }

    return seats;
}


// ----------------------------------------------
// CALCULATE EACH NESTED GROUP
// ----------------------------------------------

for (var group of electionGroups) {
    var d = group.key;
    var district_seats = group.seats;

    Q[d + "_district_seats"] = district_seats;

    var district_party_support = {};
    var max_seats_party = {};

    for (var party of Q.parties) {
        var base_support = 0;

        for (var c of Q.classes) {
            var class_share = group.demographics[c] || 0;

            base_support +=
                class_share *
                (Q[c + "_" + party + "_normalized"] || 0);
        }

        // Calculate the candidate limit for this group.
        var max_candidates = groupCaps[d][party] || 0;
        max_seats_party[party] = max_candidates;

        Q[d + "_" + party + "_base_support"] = base_support;

        // Candidate availability determines the vote contribution
        // used for the estimated contested-candidate vote share.
        var raw_support = base_support * max_candidates;

        Q[d + "_" + party + "_raw_support"] = raw_support;

        Q[party + "_raw_polls"] += raw_support;
        Q[party + "_contested_votes"] += raw_support;
        Q[party + "_national_votes"] += raw_support;
        Q._total_votes_all_seats += raw_support;

        // Keep the existing squared-support distortion.
        // RCR is applied as a cap, not a second popularity penalty.
        district_party_support[party] =
            base_support * base_support;
    }

    Q[d + "_party_support"] = district_party_support;

    // Normalize squared support.
    var party_district_support = Object.values(
        district_party_support
    ).reduce(function(a, b) {
        return a + b;
    }, 0);

    var district_polls = {};

    for (var party of Q.parties) {
        district_polls[party] =
            party_district_support > 0
                ? district_party_support[party] / party_district_support
                : 0;
    }

    // Allocate the group's seats using the existing method.
    var result = allocateSeats(
        district_polls,
        district_seats,
        max_seats_party
    );

    // Store group results and aggregate them into regional totals.
    for (var party of Q.parties) {
        var won = result[party] || 0;

        Q[d + "_" + party + "_seats"] = won;
        group.results[party] = won;

        Q[party + "_seats"] += won;

        if (group.key !== group.region) {
            Q[group.region + "_" + party + "_seats"] += won;
        } else {
            Q[group.region + "_" + party + "_seats"] = won;
        }
    }
}


// ----------------------------------------------
// BUILD REGIONAL RESULTS
// Keep the old name / seats / results interface
// and add nested group detail.
// ----------------------------------------------

for (var regionName in Q.districts) {
    var regionGroups = groupsByRegion[regionName] || [];

    var regionSeats = regionGroups.reduce(function(total, group) {
        return total + group.seats;
    }, 0);

    var regionResults = {};
    var groupResults = [];

    for (var party of Q.parties) {
        regionResults[party] =
            Q[regionName + "_" + party + "_seats"] || 0;
    }

    for (var group of regionGroups) {
        groupResults.push({
            name: group.name,
            seats: group.seats,
            results: group.results
        });
    }

    Q.district_results_legislative.push({
        name: regionName,
        seats: regionSeats,
        results: regionResults,
        constituencies: groupResults
    });
}

console.log(Q.district_results_legislative);


// ----------------------------------------------
// CALCULATE SQUARED-SUPPORT SHARE
// Weight each group by its number of seats.
// ----------------------------------------------

var total_support = 0;

for (var group of electionGroups) {
    var weights = Q[group.key + "_party_support"] || {};

    var groupSupport = Object.values(weights).reduce(
        function(a, b) {
            return a + b;
        }, 0
    );

    total_support += groupSupport * group.seats;
}

for (var party of Q.parties) {
    var party_support = 0;

    for (var group of electionGroups) {
        var weights = Q[group.key + "_party_support"] || {};

        party_support +=
            (weights[party] || 0) * group.seats;
    }

    Q[party + "_r"] =
        total_support > 0
            ? Math.round((party_support / total_support) * 1000) / 10
            : 0;

    Q[party + "_r_disp"] = Q[party + "_r"].toFixed(1);
}


// ----------------------------------------------
// CALCULATE ESTIMATED VOTE SHARE
// Weighted by the number of candidates contested.
// ----------------------------------------------

var total_polls = 0;

for (var party of Q.parties) {
    total_polls += Q[party + "_raw_polls"];
}

for (var party of Q.parties) {
    Q[party + "_polls"] =
        total_polls > 0
            ? Math.round(
                (Q[party + "_raw_polls"] / total_polls) * 1000
            ) / 10
            : 0;

    Q[party + "vote_change"] =
        Q[party + "_polls"] -
        (Q["old_" + party + "_polls"] || 0);
}

console.log("Vote shares (party_polls):");

for (var party of Q.parties) {
    console.log(party, Q[party + "_polls"]);
}


// Q.lps_polls = Q.lps_polls.toFixed(1);
// Q.ccf_polls = Q.ccf_polls.toFixed(1);
// Q.pps_polls = Q.pps_polls.toFixed(1);
// Q.cps_polls = Q.cps_polls.toFixed(1);
// Q.other_polls = Q.other_polls.toFixed(1);
// Q.cpc_s_polls = Q.cpc_s_polls.toFixed(1);
// Q.scps_polls = Q.scps_polls.toFixed(1);


!}
go-to: post_election

# note: this is a helpful utility to deal with elections and so on.


@post_election
on-arrival: {!

// Q.total_assembly_seats = 110;

/*
 'saskatoon', 'moosejaw_d', 
    'southeast', 'southwest', 
    'central', 'north'
*/

// set old results
// election threshold constitutional reform
// banning parties

var new_party_sum = 0;
for (var party of Q.parties) {
    Q['old_' + party + '_r'] = Q[party + '_r'];
    if (Q.constitutional_reform > 0) {
        if (Q[party + '_polls'] < Q.electoral_threshold || (Q.electoral_threshold > 1 && party == 'other') || Q[party + '_banned']) {
            Q[party + '_r'] = 0;
        } else {
            Q[party + '_r'] = Q[party + '_seats'];
        }
        new_party_sum += Q[party + '_r'];
    } else {
        Q[party + '_r'] = Q[party + '_seats'];
    }
    // if we use decimals, then we might want to truncate the numbers
    if (Q.use_decimals) {
        Q[party + '_r_disp'] = Q[party+'_r'];
    }  else {
            Q[party + '_r_disp'] = Q[party+'_r'];
    }
    Q['change_' + party + '_r'] = Q[party + '_r'] - Q['old_' + party + '_r'];
    //var sign = Q['change_' + party + '_r'] > 0 ? '+'  : '';
    //Q['str_change_' + party] = sign + Q['change_' + party + '_r'].toFixed(1);
    var sign = Q['change_' + party + '_r'] > 0 
                    ? '<img src="img/arrowup.png"> ' 
                    : Q['change_' + party + '_r'] < 0 
                      ? '<img src="img/arrowdown.png"> ' 
                      : '<img src="img/steady.png"> ';
        Q['str_change_' + party] = sign + Math.abs(Q['change_' + party + '_r']).toFixed(1);
}

// calculate new party sum if electoral reform

if (Q.electoral_threshold && Q.electoral_threshold > 0) {
    for (var party of Q.parties) {
        if (Q[party + '_r'] > 0) {
            if (Q.use_decimals) {
                Q[party + '_r'] = Math.round(Q[party + '_r']*1000/new_party_sum)/10;
            } else {
                Q[party + '_r'] = Math.round(Q[party + '_r']*100/new_party_sum);
            }
        }
        if (Q.use_decimals) {
            Q[party + '_r_disp'] = Q[party+'_r'];
        } else {
            Q[party + '_r_disp'] = Q[party+'_r'];
        }

        Q['change_' + party + '_r'] = Q[party + '_r'] - Q['old_' + party + '_r'];
        // var sign = Q['change_' + party + '_r'] > 0 ? '+'  : '';
        // Q['str_change_' + party] = sign + Q['change_' + party + '_r'].toFixed(1);

        var sign = Q['change_' + party + '_r'] > 0 
                    ? '<img src="img/arrowup.png"> ' 
                    : Q['change_' + party + '_r'] < 0 
                      ? '<img src="img/arrowdown.png"> ' 
                      : '<img src="img/steady.png"> ';
        Q['str_change_' + party] = sign + Math.abs(Q['change_' + party + '_r']).toFixed(1);
    }
}

for (var party of Q.parties) {
    Q['change_' + party + '_seats'] = Q[party + '_seats'] - Q['old_' + party + '_seats'];
    var sign_seats = Q['change_' + party + '_seats'] > 0 
                    ? '<img src="img/arrowup.png"> ' 
                    : Q['change_' + party + '_seats'] < 0 
                      ? '<img src="img/arrowdown.png"> ' 
                      : '<img src="img/steady.png"> ';
        Q['seats_change_' + party] = sign_seats + Math.abs(Q['change_' + party + '_seats']);
}


// The largest party can only be the [+ party_names.ccf +], LPS, CPS, or SCPS.
Q.largest_party = Q.party_names.ccf;

if (Q.lps_seats >= Q.ccf_seats && Q.lps_seats >= Q.cps_seats && Q.lps_seats >= Q.scps_seats) {
    Q.largest_party = 'LPS';
}
if (Q.cps_seats >= Q.ccf_seats && Q.cps_seats >= Q.lps_seats && Q.cps_seats >= Q.scps_seats) {
    Q.largest_party = 'CPS';
}
if (Q.scps_seats >= Q.ccf_seats && Q.scps_seats >= Q.lps_seats && Q.scps_seats >= Q.cps_seats) {
    Q.largest_party = 'SCPS';
}

// coalitions
Q.lps_coalition = Math.round((Q.ccf_seats + Q.lps_seats) * 10) / 10;
Q.pps_coalition = Math.round((Q.ccf_seats + Q.pps_seats) * 10) / 10;
Q.grand_coalition = Math.round((Q.ccf_seats + Q.lps_seats + Q.pps_seats + Q.cps_seats) * 10) / 10;
Q.bourgeois_coalition = Math.round((Q.lps_seats + Q.cps_seats + Q.other_seats) * 10) / 10;
Q.conservative_coalition = Math.round((Q.cps_seats + Q.scps_seats) * 10) / 10;
Q.right_coalition = Math.round((Q.cps_seats + Q.other_seats + Q.scps_seats) * 10) / 10;
Q.scps_majority = Math.round(Q.scps_seats * 10) / 10;
Q.left_coalition = Math.round((Q.ccf_seats + Q.cpc_s_seats) * 10) / 10;
Q.cooperative_coalition = Math.round((Q.cps_seats + Q.pps_seats + Q.other_seats) * 10) / 10;
// this is an absurd concept lol
Q.unity_government_coalition = Math.round((Q.ccf_seats + Q.cpc_s_seats + Q.pps_seats + Q.lps_seats + Q.sapd_seats) * 10) / 10;
Q.anti_democratic_coalition = Math.round((Q.cpc_s_seats + Q.scps_seats) * 10) / 10;
// aka everyone except scps, cpc_s, scps
Q.neo_lps_coalition = Math.round((Q.ccf_seats + Q.lps_seats + Q.pps_seats + Q.cps_seats + Q.other_seats) * 10) / 10;
// Needham + Right-wing parties (only comes into effect if you've alienated PPS too badly)
Q.needham_right_coalition = Math.round((Q.scps_seats + Q.cps_seats + Q.other_seats) * 10) / 10;
// Progressive coalition isn't going to be implemented as a distinct coalition but it's the coalition that lets you pass improved women's rights/gay rights
Q.progressive_coalition = Math.round((Q.ccf_seats + Q.cpc_s_seats + Q.lps_seats + Q.sapd_seats) * 10) / 10;

if (Q.cpc_s_relation >= 30) {
    Q.lps_coalition += Q.sapd_seats;
}

Q.leverage = Q.ccf_r;

Q.grand_coalition_failed = 0;
// Reset government and ministers... Based on Brüning's 1930 govt
Q.coalition_dissent = 0;
Q.cpc_s_coalition_dissent = 0;
Q.ccf_in_government = 0;
Q.in_lps_coalition = 0;
Q.in_grand_coalition = 0;
Q.in_left_front = 0;
Q.in_unity_government = 0;
Q.in_emergency_government = 0;
Q.in_minority_government = 0;
Q.ccf_toleration = 0;
Q.ccf_caretaker = 0;
// New Ministries
Q.cooperatives_minister_party = 'PPS';
Q.education_minister_party = 'PPS';
Q.mineral_resources_minister_party = 'PPS';
Q.municipal_affairs_minister_party = 'PPS';
Q.transportation_minister_party = 'PPS';
Q.telephones_telegraphs_minister_party = 'PPS';
// Old Ministries
Q.foreign_minister_party = 'CPS';
Q.interior_minister_party = 'PPS';
Q.justice_minister_party = 'I';
Q.labour_minister_party = 'PPS';
Q.rcmp_minister_party = 'I';
Q.economic_minister_party = Q.lps_name;
Q.finance_minister_party = 'CPS';
Q.agriculture_minister_party = 'PPS';

// reset CPC(S) goals
Q.cpc_s_goals_seen = 0;
Q.cpc_s_ultimatum_seen = 0;
Q.welfare_goal = 0;
Q.agriculture_goal = 0;
Q.economy_goal = 0;
Q.finance_goal = 0;
Q.labour_goal = 0;
Q.foreign_goal = 0;
Q.interior_goal = 0;
Q.rcmp_goal = 0;

Q.welfare_goal_completed = 0;
Q.agriculture_goal_completed = 0;
Q.economy_goal_completed = 0;
Q.finance_goal_completed = 0;
Q.labour_goal_completed = 0;
Q.foreign_goal_completed = 0;
Q.interior_goal_completed = 0;
Q.rcmp_goal_completed = 0;

Q.strike_term_seen = 0;

// understanding the enemy
if (Q.scps_seats >= 15) {
    Q.understanding_enemy_timer = 2;
}

var election_result = {'date': new Date(Q.year, Q.month - 1)};
for (var party of Q.parties) {
    election_result[party] = Q[party + '_r'];
}
Q.election_records.push(election_result);
!}
on-departure: scps_urgency = 1 if (scps_urgency == 0 and scps_seats >= 15)
on-display: {!
data = [
    {
        "id": "ccf",
        "legend": "[+ party_names.ccf +]",
        "name": "[+ party_names.ccf +]",
        "seats": Q.ccf_seats,
        "bench": Q.ccf_in_government
    },
    {
        "id": "cpc_s",
        "legend": "CPC(S)",
        "name": "CPC(S)",
        "seats": Q.cpc_s_seats,
        "bench": Q.cpc_s_in_government
    }
];
if (Q.sapd_formed && Q.sapd_seats) {
    data.push({
            "id": "sapd",
            "legend": "SAPD",
            "name": "SAPD",
            "seats": Math.round(Q.sapd_r * 0.6),
            "bench": 0
            });
}

data = data.concat([
    {
        "id": "lps",
        "legend": "LPS",
        "name": "LPS",
        "seats": Q.lps_seats,
        "bench": Q.lps_in_government
    },
    {
        "id": "pps",
        "legend": "PPS",
        "name": "PPS",
        "seats": Q.pps_seats, 
        "bench": Q.pps_in_government
    },
    {
        "id": "cps",
        "legend": "CPS",
        "name": "CPS",
        "seats": Q.cps_seats, 
        "bench": Q.cps_in_government
    },
    {
        "id": "other",
        "legend": "Other",
        "name": "Other",
        "seats": Q.other_seats, 
        "bench": Q.other_in_government
    },
    {
        "id": "scps",
        "legend": "SCPS",
        "name": "SCPS",
        "seats": Q.scps_seats, 
        "bench": Q.scps_in_government
        /* "seats": Math.round(Q.scps_r * 0.6), */
    },
]);

data = data.filter(p => p.seats > 0);

console.log("Seat totals by party:");
for (var party of Q.parties) {
