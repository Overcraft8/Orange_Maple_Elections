    {!<div style="overflow-x:auto;">!}
    {!<table class="generic-table"!}
        {!<tr>!}
            {!<th>District</th>!}
            {!<th>Seats</th>!}
            {!<th>CPC(S)</th>!}
            {!<th>!}[+ ccf_name +]{!</th>!}
            {!<th>PPS</th>!}
            {!<th>LPS</th>!}
            {!<th>CPS</th>!}
            {!<th>Other</th>!}
            [? if scps_formed : {!<th>SCPS</th>!} ?]
        {!</tr>!}
        {!<tr>!}
            {!<td>!}**Regina**{!</td>!}
            {!<td>!}[+ regina_d_district_seats +]{!</td>!}
            {!<td>!}[+ regina_d_cpc_s_seats +]{!</td>!}
            {!<td>!}[+ regina_d_ccf_seats +]{!</td>!}
            {!<td>!}[+ regina_d_pps_seats +]{!</td>!}
            {!<td>!}[+ regina_d_lps_seats +]{!</td>!}
