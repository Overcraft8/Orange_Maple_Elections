= Elections, [+ month : month +] [+ year +]

The Legislative elections are to be held now.

- @election_algorithm_sk: May we do our best...


@election_algorithm_sk
on-arrival: {!


// Lots of this election code taken from the Beeshana Kelaya mod...
Q.district_results_legislative = [];

Q.use_decimals = 1;

for (var party of Q.parties) {
    Q['old_' + party + '_seats'] = Q[party + '_seats'];
    Q['old_' + party + '_polls'] = Q[party + '_polls'];
}


// Recalculate total population and class population just in case
Q.total_population = 0;

for (var c of Q.classes) {
    Q[c + '_total_population'] = 0;
    for (var d of Q.district_names) {
        if (Q[d + '_' + c] !== undefined) {
            Q[c + '_total_population'] += (Number(Q[d + '_' + c]) * Number(Q[d + '_seats'])) || 0;
        }
    }
    Q.total_population += Q[c + '_total_population'];
}

for (var c of Q.classes) {
    if (Q.total_population > 0) {
        Q[c + '_population_percent'] = 100 * Q[c + '_total_population'] / Q.total_population;
    } else {
        Q[c + '_population_percent'] = 0;
    }
    console.log(c + ' population percent: ' + Q[c + '_population_percent']);
}





// 1. Normalize class voting shares (0–100)
for (var c of Q.classes) {
    var class_polls = 0;
    for (var party of Q.parties) {
        if (Q[c + '_' + party] < 0) Q[c + '_' + party] = 0;
        class_polls += Q[c + '_' + party];
    }
    for (var party of Q.parties) {
        Q[c + '_' + party + '_normalized'] = class_polls > 0 ? Q[c + '_' + party] / class_polls : 0;
    }
}

// 2. Reset seat counts
for (var party of Q.parties) {
    Q[party + '_seats'] = 0;
}

// allocate seats function
function allocateSeats(votes, totalSeats) {
    var seats = {};
    for (var p in votes) seats[p] = 0; // Set all party seats at 0

    for (var s = 0; s < totalSeats; s++) { //Loop once per seat to allocate
        var maxQ = -1;
        var winner = null; // 'winning' party of the seat
        for (var p in votes) {
            var q = votes[p] / (seats[p] + 1); // D'hondt quotient for each party
            if (q > maxQ) { // If this party has the highest quotient so far, they are the current winner of the seat
                maxQ = q; // Update maxQ to this party's quotient
                winner = p; // Winner of the seat is the party with the highest quotient
            }
        }
        seats[winner]++; //Increase winner seat count by 1
    }
    return seats; //return final seat distribution for all parties contesting
}

// 4. Loop over districts
for (var d of Q.district_names) { // Loop though 'd' for districts of Q.district_names
    var district_seats = Q[d + '_seats'] || 0; // district_seats is that districts name + '_seats' (e.g. regina_d_seats) or 0 if that doesn't exist, changes each loop
    Q[d + '_district_seats'] = district_seats; // store district seats in the old Q variable
    if (d == 'regina_d') {
        console.log("District:", d, "Seats:", district_seats);
    }

    var district_party_support = {}; // Dictionary to hold support for each party's support in this district

    // Compute raw support per party in this district
    for (var party of Q.parties) {
        var support = 0;
        for (var c of Q.classes) {
            var class_share = Q[d + '_' + c] || 0; // Class share - proportion of class in the district

            if (Q.old_demographics) {
                support += class_share * (Q[c + '_' + party] || 0);
            } else {
                support += class_share * (Q[c + '_' + party + '_normalized'] || 0);
            }
        }

        Q[d + '_' + party + '_raw_support'] = support; // Store raw support for this party in this district

        // Cubing for FPTP simulation (rudimentary, ik)
        console.log(party, support)
        district_party_support[party] = support * support; // FPTP Distorted
    }

    Q[d + '_party_support'] = district_party_support; // Save FPTP distorted support for the district

    // Normalize distorted votes to 1
    var total_support = Object.values(district_party_support).reduce((a, b) => a + b, 0);
    var district_polls = {};
    for (var party of Q.parties) {
        district_polls[party] = total_support > 0 ? district_party_support[party] / total_support : 0;
    }

    // Allocate seats
    var result = allocateSeats(district_polls, district_seats);

    // Store + add to party seat total
    for (var party of Q.parties) {
        Q[d + '_' + party + '_seats'] = result[party]; //District-level seat results
        Q[party + '_seats'] += result[party]; // Add to party's total seat count
    }
}

// 
for (var d of Q.district_names) {

    var results = {}; // Soon to be dictionary

    for (var party of Q.parties) {
        results[party] = Q[d + "_" + party + "_seats"] || 0; //results[specific party] is number of seats that specific party won in this district (or 0)
    }

    Q.district_results_legislative.push({ // Another dictionary (?) to hold all information for election results
        name: d, // Name of district
        seats: Q[d + '_district_seats'] || 0, // total seats in this district
        results: results // Dictionary for this district's results by party
    });
}

console.log(Q.district_results_legislative);



// 5. Compute total vote share (party_r)
var grand_total_support = 0;
for (var d of Q.district_names) {
    grand_total_support += Object.values(Q[d + '_party_support']).reduce((a,b)=>a+b,0);
}

for (var party of Q.parties) {
    var combined_support = 0;
    for (var d of Q.district_names) {
        combined_support += Q[d + '_party_support'][party] || 0;
    }

    // party_r = total vote share in percent
    Q[party + '_r'] = grand_total_support > 0 ? Math.round((combined_support / grand_total_support) * 1000)/10 : 0;

    // Display
    Q[party + '_r_disp'] = Q[party + '_r'].toFixed(1);
}

// Calculating voteshare!

for (var party of Q.parties) {
    Q[party + '_raw_polls'] = 0;
    for (var d of Q.district_names) {
        Q[party + '_raw_polls'] += Q[d + '_' + party + '_raw_support']
    }
}


var total_polls = 0;

for (var party of Q.parties) {
    total_polls += Q[party + '_raw_polls'];
}

for (var party of Q.parties) {
    Q[party + '_polls'] = total_polls > 0 ? Math.round((Q[party + '_raw_polls'] / total_polls) * 1000)/10 : 0;
    Q[party + 'vote_change'] = Q[party + '_polls'] - (Q['old_' + party + '_polls'] || 0);
}

console.log("Vote shares (party_polls):");
for (var party of Q.parties) {
    console.log(party, Q[party + '_polls']);
}

// Q.lps_polls = Q.lps_polls.toFixed(1);
// Q.ccf_polls = Q.ccf_polls.toFixed(1);
// Q.pps_polls = Q.pps_polls.toFixed(1);
// Q.cps_polls = Q.cps_polls.toFixed(1);
// Q.other_polls = Q.other_polls.toFixed(1);
// Q.cpc_s_polls = Q.cpc_s_polls.toFixed(1);
// Q.scps_polls = Q.scps_polls.toFixed(1);


!}
go-to: post_election_1928

# note: this is a helpful utility to deal with elections and so on.


@post_election_1928
on-arrival: {!

// Q.total_assembly_seats = 110;

/*
 'saskatoon_d', 'moosejaw_d', 
    'southeast_d', 'southwest_d', 
    'central_d', 'north_d'
*/

// set old results
// election threshold constitutional reform
// banning parties

var new_party_sum = 0;
for (var party of Q.parties) {
    Q['old_' + party + '_r'] = Q[party + '_r'];
    if (Q.constitutional_reform > 0) {
        if (Q[party + '_polls'] < Q.electoral_threshold || (Q.electoral_threshold > 1 && party == 'other') || Q[party + '_banned']) {
            Q[party + '_r'] = 0;
        } else {
            Q[party + '_r'] = Q[party + '_seats'];
        }
        new_party_sum += Q[party + '_r'];
    } else {
        Q[party + '_r'] = Q[party + '_seats'];
    }
    // if we use decimals, then we might want to truncate the numbers
    if (Q.use_decimals) {
        Q[party + '_r_disp'] = Q[party+'_r'];
    }  else {
            Q[party + '_r_disp'] = Q[party+'_r'];
    }
    Q['change_' + party + '_r'] = Q[party + '_r'] - Q['old_' + party + '_r'];
    //var sign = Q['change_' + party + '_r'] > 0 ? '+'  : '';
    //Q['str_change_' + party] = sign + Q['change_' + party + '_r'].toFixed(1);
    var sign = Q['change_' + party + '_r'] > 0 
                    ? '<img src="img/arrowup.png"> ' 
                    : Q['change_' + party + '_r'] < 0 
                      ? '<img src="img/arrowdown.png"> ' 
                      : '<img src="img/steady.png"> ';
        Q['str_change_' + party] = sign + Math.abs(Q['change_' + party + '_r']).toFixed(1);
}

// calculate new party sum if electoral reform

if (Q.electoral_threshold && Q.electoral_threshold > 0) {
    for (var party of Q.parties) {
        if (Q[party + '_r'] > 0) {
            if (Q.use_decimals) {
                Q[party + '_r'] = Math.round(Q[party + '_r']*1000/new_party_sum)/10;
            } else {
                Q[party + '_r'] = Math.round(Q[party + '_r']*100/new_party_sum);
            }
        }
        if (Q.use_decimals) {
            Q[party + '_r_disp'] = Q[party+'_r'];
        } else {
            Q[party + '_r_disp'] = Q[party+'_r'];
        }

        Q['change_' + party + '_r'] = Q[party + '_r'] - Q['old_' + party + '_r'];
        // var sign = Q['change_' + party + '_r'] > 0 ? '+'  : '';
        // Q['str_change_' + party] = sign + Q['change_' + party + '_r'].toFixed(1);

        var sign = Q['change_' + party + '_r'] > 0 
                    ? '<img src="img/arrowup.png"> ' 
                    : Q['change_' + party + '_r'] < 0 
                      ? '<img src="img/arrowdown.png"> ' 
                      : '<img src="img/steady.png"> ';
        Q['str_change_' + party] = sign + Math.abs(Q['change_' + party + '_r']).toFixed(1);
    }
}

for (var party of Q.parties) {
    Q['change_' + party + '_seats'] = Q[party + '_seats'] - Q['old_' + party + '_seats'];
    var sign_seats = Q['change_' + party + '_seats'] > 0 
                    ? '<img src="img/arrowup.png"> ' 
                    : Q['change_' + party + '_seats'] < 0 
                      ? '<img src="img/arrowdown.png"> ' 
                      : '<img src="img/steady.png"> ';
        Q['seats_change_' + party] = sign_seats + Math.abs(Q['change_' + party + '_seats']);
}


// The largest party can only be the [+ ccf_name +], LPS, CPS, or SCPS.
Q.largest_party = Q.ccf_name;

if (Q.lps_seats >= Q.ccf_seats && Q.lps_seats >= Q.cps_seats && Q.lps_seats >= Q.scps_seats) {
    Q.largest_party = 'LPS';
}
if (Q.cps_seats >= Q.ccf_seats && Q.cps_seats >= Q.lps_seats && Q.cps_seats >= Q.scps_seats) {
    Q.largest_party = 'CPS';
}
if (Q.scps_seats >= Q.ccf_seats && Q.scps_seats >= Q.lps_seats && Q.scps_seats >= Q.cps_seats) {
    Q.largest_party = 'SCPS';
}

// coalitions
Q.lps_coalition = Math.round((Q.ccf_seats + Q.lps_seats) * 10) / 10;
Q.pps_coalition = Math.round((Q.ccf_seats + Q.pps_seats) * 10) / 10;
Q.grand_coalition = Math.round((Q.ccf_seats + Q.lps_seats + Q.pps_seats + Q.cps_seats) * 10) / 10;
Q.bourgeois_coalition = Math.round((Q.lps_seats + Q.cps_seats + Q.other_seats) * 10) / 10;
Q.conservative_coalition = Math.round((Q.cps_seats + Q.scps_seats) * 10) / 10;
Q.right_coalition = Math.round((Q.cps_seats + Q.other_seats + Q.scps_seats) * 10) / 10;
Q.scps_majority = Math.round(Q.scps_seats * 10) / 10;
Q.left_coalition = Math.round((Q.ccf_seats + Q.cpc_s_seats) * 10) / 10;
Q.cooperative_coalition = Math.round((Q.cps_seats + Q.pps_seats + Q.other_seats) * 10) / 10;
// this is an absurd concept lol
Q.unity_government_coalition = Math.round((Q.ccf_seats + Q.cpc_s_seats + Q.pps_seats + Q.lps_seats + Q.sapd_seats) * 10) / 10;
Q.anti_democratic_coalition = Math.round((Q.cpc_s_seats + Q.scps_seats) * 10) / 10;
// aka everyone except scps, cpc_s, scps
Q.neo_lps_coalition = Math.round((Q.ccf_seats + Q.lps_seats + Q.pps_seats + Q.cps_seats + Q.other_seats) * 10) / 10;
// Needham + Right-wing parties (only comes into effect if you've alienated PPS too badly)
Q.needham_right_coalition = Math.round((Q.scps_seats + Q.cps_seats + Q.other_seats) * 10) / 10;
// Progressive coalition isn't going to be implemented as a distinct coalition but it's the coalition that lets you pass improved women's rights/gay rights
Q.progressive_coalition = Math.round((Q.ccf_seats + Q.cpc_s_seats + Q.lps_seats + Q.sapd_seats) * 10) / 10;

if (Q.cpc_s_relation >= 30) {
    Q.lps_coalition += Q.sapd_seats;
}

Q.leverage = Q.ccf_r;

Q.grand_coalition_failed = 0;
// Reset government and ministers... Based on Brüning's 1930 govt
Q.coalition_dissent = 0;
Q.cpc_s_coalition_dissent = 0;
Q.ccf_in_government = 0;
Q.in_lps_coalition = 0;
Q.in_grand_coalition = 0;
Q.in_left_front = 0;
Q.in_unity_government = 0;
Q.in_emergency_government = 0;
Q.in_minority_government = 0;
Q.ccf_toleration = 0;
Q.ccf_caretaker = 0;
// New Ministries
Q.cooperatives_minister_party = 'PPS';
Q.education_minister_party = 'PPS';
Q.mineral_resources_minister_party = 'PPS';
Q.municipal_affairs_minister_party = 'PPS';
Q.transportation_minister_party = 'PPS';
Q.telephones_telegraphs_minister_party = 'PPS';
// Old Ministries
Q.foreign_minister_party = 'CPS';
Q.interior_minister_party = 'PPS';
Q.justice_minister_party = 'I';
Q.labour_minister_party = 'PPS';
Q.rcmp_minister_party = 'I';
Q.economic_minister_party = Q.lps_name;
Q.finance_minister_party = 'CPS';
Q.agriculture_minister_party = 'PPS';

// reset CPC(S) goals
Q.cpc_s_goals_seen = 0;
Q.cpc_s_ultimatum_seen = 0;
Q.welfare_goal = 0;
Q.agriculture_goal = 0;
Q.economy_goal = 0;
Q.finance_goal = 0;
Q.labour_goal = 0;
Q.foreign_goal = 0;
Q.interior_goal = 0;
Q.rcmp_goal = 0;

Q.welfare_goal_completed = 0;
Q.agriculture_goal_completed = 0;
Q.economy_goal_completed = 0;
Q.finance_goal_completed = 0;
Q.labour_goal_completed = 0;
Q.foreign_goal_completed = 0;
Q.interior_goal_completed = 0;
Q.rcmp_goal_completed = 0;

Q.strike_term_seen = 0;

// understanding the enemy
if (Q.scps_r >= 15) {
    Q.understanding_enemy_timer = 2;
}

var election_result = {'date': new Date(Q.year, Q.month - 1)};
for (var party of Q.parties) {
    election_result[party] = Q[party + '_r'];
}
Q.election_records.push(election_result);
!}
on-departure: scps_urgency = 1 if (scps_urgency == 0 and scps_r >= 15)
on-display: {!
data = [
    {
        "id": "ccf",
        "legend": "[+ ccf_name +]",
        "name": "[+ ccf_name +]",
        "seats": Q.ccf_seats,
        "bench": Q.ccf_in_government
    },
    {
        "id": "cpc_s",
        "legend": "CPC(S)",
        "name": "CPC(S)",
        "seats": Q.cpc_s_seats,
        "bench": Q.cpc_s_in_government
    }
];
if (Q.sapd_formed && Q.sapd_r) {
    data.push({
            "id": "sapd",
            "legend": "SAPD",
            "name": "SAPD",
            "seats": Math.round(Q.sapd_r * 0.6),
            "bench": 0
            });
}

data = data.concat([
    {
        "id": "lps",
        "legend": "LPS",
        "name": "LPS",
        "seats": Q.lps_seats,
        "bench": Q.lps_in_government
    },
    {
        "id": "pps",
        "legend": "PPS",
        "name": "PPS",
        "seats": Q.pps_seats, 
        "bench": Q.pps_in_government
    },
    {
        "id": "cps",
        "legend": "CPS",
        "name": "CPS",
        "seats": Q.cps_seats, 
        "bench": Q.cps_in_government
    },
    {
        "id": "other",
        "legend": "Other",
        "name": "Other",
        "seats": Q.other_seats, 
        "bench": Q.other_in_government
    },
    {
        "id": "scps",
        "legend": "SCPS",
        "name": "SCPS",
        "seats": Q.scps_seats, 
        "bench": Q.scps_in_government
        /* "seats": Math.round(Q.scps_r * 0.6), */
    },
]);

data = data.filter(p => p.seats > 0);

console.log("Seat totals by party:");
for (var party of Q.parties) {
    console.log(party, Q[party+'_seats']);
}

Q.parliament_diagram = data

/* 
