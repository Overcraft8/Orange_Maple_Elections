    Q.lps_seats += 1;
    Q.cps_seats += 3; 

    Q.central_d_pps_seats -= 2;
    Q.central_d_ccf_ss_seats += 1; 
    Q.central_d_lps_seats += 1; 
    Q.southeast_d_pps_seats -= 2; 
    Q.southeast_d_cps_seats += 2; 
    Q.southwest_d_pps_seats -= 1; 
    Q.southwest_d_cps_seats += 1;

    window.updateBar('left');
