title: SaskPower
subtitle: Saskatchewan Power Corporation
on-arrival: {!
    Q.saskpower_revenue_display = 0;
    var revenue = Q.saskpower.revenue
    for (var val of Object.values(revenue)) {
        Q.saskpower_revenue_display += val;
    };

    Q.private_share = Q.economic_data.electricity.private;
    Q.coop_share = Q.economic_data.electricity.coop
    Q.monopoly_cost = Math.round((Q.private_share + Q.coop_share)*10, 2);
    console.log(Q.monopoly_cost);

    Q.saskpower_sheet = window.generate_crown_info(Q.saskpower); 
!}

= SaskPower

SaskPower is the Crown Corporation dealing with power generation and distribution. Formed as the Saskatchewan Power Comission, it has made significant inroads into the private market, having purchased various independently-owned electrical utilities.

<div id="saskpower_mandate" class="gov_panel" style="width: 100%;">
    <div class="panel_title" style="font-family: Georgia, Franklin Gothic Medium, Arial; font-size: 2em; padding: 0.5em;">The SaskPower Mandate</div>
    
    <div class="net_return_panel" style="">
        Current SaskPower Electricity Rates: [+ saskpower.revenue.rates : saskpower_rates +]
    </div>

    <div class="net_return_panel" style="">
        Electrification Progress: [+ electrification : electrification +]
    </div>

</div>


# <div style="display: flex; flex-direction: row;">
#     <div class="gov_panel">
#         Rates: [+ saskpower.revenue.rates +]
#         = SaskPower Revenue: [+ saskpower_revenue_display +]
#     </div>
#     <div class="gov_panel">
#         Administration: [+ saskpower.expenses.admin +]
#         Maintenance: [+ saskpower.expenses.maintenance +]
#         = SaskPower Expenses: [+ saskpower_revenue_display +]
#     </div>
# </div>

<div id="saskpower_">

[+ saskpower_sheet +]

- @saskpower_monopoly: Grant SaskPower a Monopoly on Power
- @power_buyout: Buy Out Electrical Utilities Companies
- @power_sellout: Sell Parts of SaskPower to Private Companies
- @rural_electrification: Expand Access to Electricity
- @raise_saskpower_rates: Raise Electricity Rates
- @lower_saskpower_rates: Lower Electricity Rates
- @government_options.crown_corps_options: Return 


@saskpower_monopoly
subtitle: -[+ monopoly_cost +] budget, 100% Market Share, Increased Capital Flight
view-if: 1 = 1
choose-if: treasury >= 8
on-arrival: {!
    var market_info = Q.economic_data.electricity.marketshare; 
    market_info.private = 0; 
    market_info.coop = 0; 
    market_info.state = 1;
    Q.treasury -= Q.monopoly_cost; 
    Q.economic_data.electricity.business_climate -= 100;
!}
go-to: exit_gov

@power_buyout
subtitle: -1 budget, +10% Market Share
choose-if: treasury >= 1
on-arrival: {!
    var market_info = Q.economic_data.electricity.marketshare; 
    market_info.private -= 0.1;
    market_info.state += 0.1;
    Q.treasury -= 1;
!}
go-to: exit_gov

@power_sellout
subtitle: +1 budget, -10% Market Share
choose-if: economic_data.electricity.marketshare.state >= 0.1
on-arrival: {! 
    var market_info = Q.economic_data.electricity.marketshare; 
    market_info.state -= 0.1;
    market_info.private += 0.1;
    Q.treasury += 1;
!}
go-to: exit_gov

@electrical_coop_sellout
subtitle: -10% Market Share, +10% Co-op Market Share
choose-if: economic_data.electricity.marketshare.state >= 0.1
on-arrival: {!
    var market_info = Q.economic_data.electricity.marketshare; 
    market_info.state -= 0.1;
    market_info.coop += 0.1;
!}
go-to: exit_gov


@rural_electrification
subtitle: -1 budget
choose-if: treasury >= 1
on-arrival: {!
    Q.economic_data.electricity.contribution += 1;
    // This increases economic contribution
!}
go-to: exit_gov

@lower_saskpower_rates
on-arrival: {!
    if (Q.saskpower.revenue.rates > 0) {
        Q.saskpower.revenue.rates -= 1
    };

    for (var c of Q.classes) {
        Q[c + '_ccf_ss'] += 1
    };
!}
subtitle: -1 SaskPower revenue
go-to: exit_gov

@raise_saskpower_rates
on-arrival: {!
    if (Q.saskpower.revenue.rates > 0) {
        Q.saskpower.revenue.rates += 1
    };

    for (var c of Q.classes) {
        Q[c + '_ccf_ss'] -= 2
    };
!}
subtitle: +1 SaskPower revenue
go-to: exit_gov