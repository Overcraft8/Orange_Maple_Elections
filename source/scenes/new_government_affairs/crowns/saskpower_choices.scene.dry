title: SaskPower
subtitle: Saskatchewan Power Corporation
new-page: true
on-arrival: {!
    Q.saskpower_revenue_display = 0;
    var revenue = Q.saskpower.revenue
    for (var val of Object.values(revenue)) {
        Q.saskpower_revenue_display += val;
    };

    Q.private_share = Q.economic_data.electricity.marketshare.private;
    Q.coop_share = Q.economic_data.electricity.marketshare.coop
    Q.monopoly_cost = Math.round((Q.private_share + Q.coop_share)*10);
    console.log(Q.monopoly_cost);

    Q.saskpower_sheet = window.generate_crown_info(Q.saskpower);
    
    var sectorData = Q.economic_data['electricity'];

    var market_shares = sectorData.marketshare; 

    var electricity_pieData = {
        privateSector: { 
            share: Math.round(market_shares.private * 100), 
            color: 'rgba(90, 90, 209, 0.9)', 
            tooltipInfo: 'Private (Blue)' 
        },
        cooperative: { 
            share: Math.round(market_shares.coop * 100), 
            color: 'rgba(218, 222, 103, 0.9)', 
            tooltipInfo: 'Co-op (Yellow)' 
        },
        crownCorp: { 
            share: Math.round(market_shares.state * 100), 
            color: 'rgba(222, 157, 103, 0.9)', 
            tooltipInfo: 'Crown (Orange)' 
        }
    };

    var sources_final = {};
    var total_sources = 0;

    for (let source of Object.values(Q.saskpower.Power_Sources)) {
        total_sources += source;
    }

    for (var [source, source_quantity] of Object.entries(Q.saskpower.Power_Sources)) {
        sources_final[source] = Math.round((source_quantity / total_sources) * 100);
    }
    


    var sources_pieData = {
        coal : {
            share: sources_final.Coal || 0, 
            color: 'rgba(155, 155, 155, 0.9)', 
            tooltipInfo: 'Coal (Grey)' 
        }, 
        hydro : {
            share: sources_final.Hydro || 0, 
            color: 'rgba(45, 138, 154, 0.9)', 
            tooltipInfo: 'Hydro (Blue)' 
        }
    }

    Q['electricity_pie_chart'] = window.GeneratePieChart(electricity_pieData);
    Q['electricity_sources_pie_chart'] = window.GeneratePieChart(sources_pieData);


!}

<div id="saskpower_mandate" class="main_panel" style="background-image: url('img/telecom_lines.jpg');">
    <div class="gov_header">
        <span class="gov_panel_title">The SaskPower Mandate</span>
        <span class="gov_header_subtitle">Saskatchewan Power Corporation</span>
    </div>
    
    <div class="gov_dashboard">
        <div class="gov_panel" style="display:flex;flex-direction:column;">
        <span class="gov_stat_title">Current SaskPower Electricity Rates</span>
            <span style="border-radius: 4px" class="gov_chart_row">
                [+ saskpower.revenue.rates : saskpower_rates +]
            </span>
            <div class="gov_stat_label">Cost on Consumers</div>
        </div>

        <div class="gov_panel" style="display:flex;flex-direction:column;">
            <span class="gov_stat_title">Electrification Progress</span>
            <span style="border-radius: 4px" class="gov_chart_row">
                [+ electrification : electrification +]
            </span>
        </div>

        <div class="gov_panel" style="display:flex;flex-direction:column;">
            <span class="gov_stat_title">Electricity Market Shares</span>
            <span style="border-radius: 4px" class="gov_chart_row">
                [+ electricity_pie_chart +]
            </span>
        </div>

        <div class="gov_panel" style="display:flex;flex-direction:column;">
            <span class="gov_stat_title">SaskPower Generation Sources</span>
            <span style="border-radius: 4px" class="gov_chart_row">
                [+ electricity_sources_pie_chart +]
            </span>
        </div>
    </div>

</div>


# <div style="display: flex; flex-direction: row;">
#     <div class="gov_panel">
#         Rates: [+ saskpower.revenue.rates +]
#         = SaskPower Revenue: [+ saskpower_revenue_display +]
#     </div>
#     <div class="gov_panel">
#         Administration: [+ saskpower.expenses.admin +]
#         Maintenance: [+ saskpower.expenses.maintenance +]
#         = SaskPower Expenses: [+ saskpower_revenue_display +]
#     </div>
# </div>

<div id="saskpower_">

[+ saskpower_sheet +]

- @saskpower_monopoly: Grant SaskPower a Monopoly on Power
- @power_buyout: Buy Out Electrical Utilities Companies
- @power_sellout: Sell Parts of SaskPower to Private Companies
- @saskpower_construction: Construct new Power Generation Facilities
- @rural_electrification: Expand Access to Electricity
- @raise_saskpower_rates: Raise Electricity Rates
- @lower_saskpower_rates: Lower Electricity Rates
- @government_options.crown_corps_options: Return 


@saskpower_monopoly
subtitle: -[+ monopoly_cost +] budget
view-if: 1 = 1
choose-if: treasury >= 8
on-arrival: {!
    var market_info = Q.economic_data.electricity.marketshare; 
    market_info.private = 0; 
    market_info.coop = 0; 
    market_info.state = 1;
    Q.treasury -= Q.monopoly_cost; 
    Q.economic_data.electricity.business_climate -= 100;
!}
go-to: exit_gov

@power_buyout
subtitle: -1 budget, +10% Market Share
choose-if: treasury >= 1
on-arrival: {!
    var market_info = Q.economic_data.electricity.marketshare; 
    market_info.private -= 0.1;
    market_info.state += 0.1;
    Q.treasury -= 1;
!}
go-to: exit_gov

@power_sellout
subtitle: +1 budget, -10% Market Share
choose-if: economic_data.electricity.marketshare.state >= 0.1
on-arrival: {! 
    var market_info = Q.economic_data.electricity.marketshare; 
    market_info.state -= 0.1;
    market_info.private += 0.1;
    Q.treasury += 1;
!}
go-to: exit_gov

@electrical_coop_sellout
subtitle: -10% Market Share, +10% Co-op Market Share
choose-if: economic_data.electricity.marketshare.state >= 0.1
on-arrival: {!
    var market_info = Q.economic_data.electricity.marketshare; 
    market_info.state -= 0.1;
    market_info.coop += 0.1;
!}
go-to: exit_gov

@saskpower_construction
new-page: true

- @saskpower_choices: Return


@rural_electrification
subtitle: -1 budget
choose-if: treasury >= 1
on-arrival: {!
    Q.economic_data.electricity.contribution += 1;
    // This increases economic contribution
!}
go-to: exit_gov

@lower_saskpower_rates
on-arrival: {!
    if (Q.saskpower.revenue.rates > 0) {
        Q.saskpower.revenue.rates -= 1
    };

    for (var c of Q.classes) {
        Q[c + '_ccf'] += 1
    };
    Q.workers_ccf += 1;
!}
subtitle: -1 SaskPower revenue
go-to: exit_gov

@raise_saskpower_rates
on-arrival: {!
    if (Q.saskpower.revenue.rates > 0) {
        Q.saskpower.revenue.rates += 1
    };

    for (var c of Q.classes) {
        Q[c + '_ccf'] -= 2
    };
!}
subtitle: +1 SaskPower revenue
go-to: exit_gov