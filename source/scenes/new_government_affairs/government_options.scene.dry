title: Government
new-page: true
is-card: true
tags: govtwo
view-if: 1 = 1
card-image: img/Saskatchewan_Legislature.jpg
on-arrival: {!
    var mid_panel = document.getElementById('mid_panel');
    var content = document.getElementById('content');
    var tools = document.getElementById('tools_wrapper'); 

    var left_sidebar = document.getElementById('stats_sidebar'); 
    var right_sidebar = document.getElementById('news_frame'); 

    Q.old_mid_panel_margin = mid_panel.style.margin;
    Q.old_content_maxWidth = content.style.maxWidth; 
    Q.old_content_width = content.style.width;

    left_sidebar.style.display = 'none'; 
    right_sidebar.style.display = 'none';
    mid_panel.style.margin = '0 0';

    content.style.maxWidth = '100em';
    content.style.width = '50em';
!}


<div id="government_options_top_panel" style="display: flex;" class='tab_container'>

    <div id='crown_corps_button' class='tab_button' onclick="window.dendryUI.dendryEngine.goToScene('government_options.crown_corps_options');">Crown Corporations</div>

    <div id='ministries_button' class='tab_button' onclick="window.dendryUI.dendryEngine.goToScene('government_options.ministries_options');">Ministries</div>

    <div id="back_gov_button"  class="tab_button" onclick="window.dendryUI.dendryEngine.goToScene('exit_gov');">Back</div>

</div>

- @exit_gov: Exit Government Affairs

@crown_corps_options 
new-page: true
on-arrival: {!

Object.entries(Q.crown_economic_pairs).forEach(([crown, sectorName]) => {
    var sectorData = Q.economic_data[sectorName];

    if (!sectorData || !sectorData.marketshare) return; 

    var market_shares = sectorData.marketshare; 

    var pieData = {
        privateSector: { 
            share: Math.round(market_shares.private * 100), 
            color: 'rgba(90, 90, 209, 0.9)', 
            tooltipInfo: 'Private (Blue)' 
        },
        cooperative: { 
            share: Math.round(market_shares.coop * 100), 
            color: 'rgba(218, 222, 103, 0.9)', 
            tooltipInfo: 'Co-op (Yellow)' 
        },
        crownCorp: { 
            share: Math.round(market_shares.state * 100), 
            color: 'rgba(222, 157, 103, 0.9)', 
            tooltipInfo: 'Crown (Orange)' 
        }
    };

    Q[sectorName + '_pie_chart'] = window.GeneratePieChart(pieData); 
    
});


!}

<!--
<div class='tab_container'>
    <div id='back_crowns' class='tab_button' onclick="window.ChangeTab('center', 'government_options', 'back_crowns');">Back</div>
</div>
-->

<h1 style="margin: 0 0 0 0;">The Crown Corporations</h1>

<div style="font-size: 0.8em; text-align: center;">(Updated Annually)</div>


<div id='crown_corps_panel' style="display: flex;">

    <div id="saskpower_panel" class="gov_panel centered-bg-img" style="background: linear-gradient( color-mix(in srgb, var(--content-bg-color, #e8dcc3) 70%, transparent), rgba(255, 255, 255, 0.4) ), url('img/powerhouse.jpg') center/cover; ">
        <div class="h1_gov" style="background: var(--content-bg-color);">SaskPower</div>

        <div id='saskpower_stats' class='gov_stats'>
            <div>Electrification: [+ electrification : electrification +]</div>
            <div class="market_share_wrapper"> Market Share: [+ electricity_pie_chart +]</div>
            <div class='tab_container'>
                <div id='saskpower_options' style="justify-content: center;" class='tab_button' onclick="window.dendryUI.dendryEngine.goToScene('saskpower_choices');">Saskpower Actions</div>
            </div>
            <div class="net_return_panel">Net Return: [+ saskpower.profit +]</div>
        </div>
    </div>


    <div id="sasktel_panel" class="gov_panel centered-bg-img" style="background: linear-gradient( color-mix(in srgb, var(--content-bg-color, #e8dcc3) 70%, transparent), rgba(255, 255, 255, 0.4) ), url('img/telecom_lines.jpg') center/cover; ">
        <div class="h1_gov">SaskTel</div>

        <div id='saskpower_tel' class='gov_stats'>
            <div>Telecoms Access: [+ telecoms : telecom +]</div>
            <div class="market_share_wrapper"> Market Share: [+ telecoms_pie_chart +]</div>
            <div class='tab_container'>
                <div id='sasktel_options' style="justify-content: center;" class='tab_button' onclick="window.dendryUI.dendryEngine.goToScene('government_options.sasktel_choices');">SaskTel Actions</div>
            </div>
            <div class="net_return_panel">Net Return: [+ sasktel.profit +]</div>
        </div>
    </div>


    <div id="stc_panel" class="gov_panel centered-bg-img" style="background: linear-gradient( color-mix(in srgb, var(--content-bg-color, #e8dcc3) 70%, transparent), rgba(255, 255, 255, 0.4) ), url('img/regina_trolleybus.jpg') center/cover; ">>
        <div class="h1_gov">STC</div>

        <div id='stc_stats' class='gov_stats'>
            <div>STC Ridership: [+ state_transport : stc +]</div>
            <div class="market_share_wrapper"> Market Share: [+ transport_pie_chart +]</div>
            <div class='tab_container'>
                <div id='stc_options' style="justify-content: center;" class='tab_button' onclick="window.dendryUI.dendryEngine.goToScene('government_options.stc_choices');">STC Actions</div>
            </div>
            <div class="net_return_panel">Net Return: [+ stc.profit +]</div>
        </div>
    </div>

</div>

</div>


