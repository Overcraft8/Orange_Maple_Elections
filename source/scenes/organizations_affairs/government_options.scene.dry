@crown_corps_options 
is-hand: true
max-cards: 12
on-arrival: {!
    if (1 == 1) {
        // Start the container for all Crown cards
        var containerHtml = '<div style="display: flex; flex-wrap: wrap; gap: 0.5em; justify-content: center; margin: 0.5em;">';

        // Loop through Crown corps in the pairs dictionary
        for (var crown_id in Q.crown_economic_pairs) {
            
            var sectorName = Q.crown_economic_pairs[crown_id]; // ex., 'electricity', 'telecoms'
            var districtData = Q.economic_data[sectorName]; 

            // Check for the data
            if (districtData && districtData.marketshare) {
                var sectorData = districtData.marketshare; 
            
                if (Array.isArray(sectorData)) {
                    
                    var ownership = sectorData[0]; // [private, cooperative, state] ratios
                    var contribution = sectorData[1]; // economic contribution

                    var privateShare = Math.round(ownership[0] * 100);
                    var coopShare = Math.round(ownership[1] * 100);
                    var stateShare = Math.round(ownership[2] * 100);

                    var stop1 = privateShare;
                    var stop2 = privateShare + coopShare;
                    var tooltipText = `Private (Blue): ${privateShare}%\nCo-op (Yellow): ${coopShare}%\nCrown (Orange): ${stateShare}%`;

                    var imageName = window.economy_images && window.economy_images[sectorName] ? window.economy_images[sectorName] : 'default.png';

                    // This is the "market share" graphic
                    var cardHtml = `
                        <div class="project_container" style="
                            position: relative; 
                            display: flex; 
                            flex-direction: column; 
                            align-items: center; 
                            justify-content: center; 
                            text-align: center; 
                            background-image: url('img/${imageName}');
                            background-size: cover; 
                            background-position: center;
                            padding: 16px;
                            min-width: 80px;
                            color: #ffffff;
                            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
                            border: 2px ridge #9c8c64;
                            border-radius: 4px;
                        ">
                            <div style="background-color: rgba(0, 0, 0, 0.6); padding: 6px 10px; border-radius: 3px; width: 100%; display: flex; flex-direction: column; align-items: center;">
                                <span style="font-size: 14px; font-weight: bold; display: block; color: #f1c40f; text-transform: capitalize;">${sectorName}</span>
                                <span style="font-size: 13px; display: block;">Contribution: ${contribution}</span>
                                <figure class="pie_chart" data-tooltip="${tooltipText}" style="
                                    background: conic-gradient(
                                        rgba(90, 90, 209, 0.9) 0% ${stop1}%, 
                                        rgba(218, 222, 103, 0.9) ${stop1}% ${stop2}%, 
                                        rgba(222, 157, 103, 0.9) ${stop2}% 100%
                                    );">
                                </figure>
                            </div>
                        </div>
                    `;

                    containerHtml += cardHtml;

                    Q[sectorName + '_pie_chart'] = cardHtml;
                }
            }
        }
        
        // Close the master flex container
        containerHtml += '</div>';
        
        // Save the full combined container to a Q variable so you can display it all at once
        Q.all_crown_cards_html = containerHtml;
    }
!}

<div class='tab_container'>
    <div id='back_crowns' class='tab_button' onclick="window.ChangeTab('center', 'government_options', 'back_crowns');">Back</div>
</div>

= The Crown Corporations

