title: Government
new-page: true
is-card: true
tags: govtwo, programme
view-if: 1 = 1
card-image: img/Saskatchewan_Legislature.jpg
on-arrival: {!
    var mid_panel = document.getElementById('mid_panel');
    var content = document.getElementById('content');
    var tools = document.getElementById('tools_wrapper'); 

    var left_sidebar = document.getElementById('stats_sidebar'); 
    var right_sidebar = document.getElementById('stats_sidebar_right'); 

    left_sidebar.style.display = 'none'; 
    right_sidebar.style.display = 'none';
    mid_panel.style.margin = '0 0';

    content.style.maxWidth = '100em';
    content.style.width = '50em';
!} 
on-departure: {!
    var mid_panel = document.getElementById('mid_panel');
    var content = document.getElementById('content');
    var tools = document.getElementById('tools_wrapper'); 

    var left_sidebar = document.getElementById('stats_sidebar'); 
    var right_sidebar = document.getElementById('stats_sidebar_right'); 

    left_sidebar.style.display = ''; 
    right_sidebar.style.display = '';
    mid_panel.style.margin = '0 23em';

    content.style.maxWidth = '26em';
    content.style.width = '26em';
!}

<div id="government_options_top_panel" class='tab_container'>

    <div id='crown_corps_button' class='tab_button' style="cursor: pointer;" onclick="window.ChangeTab('center', 'government_options.crown_corps_options', 'crown_corps_button');">Crown Corporations</div>

    <div id='ministries_button' style="cursor: pointer;" class='tab_button'>Ministries</div>

    <ul class="choices" style="position: absolute; right: 1.2em; border-radius: 0; border: 0px solid #000000; ">
        <li>
            <a href="#" data-choice="0">
                <div id="ministries_button" class="tab_button">Back</div>
            </a>
        </li>
    </ul>

</div>


