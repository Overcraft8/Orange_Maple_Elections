@start
on-arrival: {!
Q.started = 1;
// time elapsed (in months)
Q.time = 1;
Q.year = 1932;
Q.prev_year = 1931;
Q.month = 1;
// how many actions have been taken this month?
Q.month_actions = 0;
Q.last_month = 0

// 0 = normal difficulty, 1 = hard mode, 2 = hard mode no saves
Q.difficulty = 0;
Q.historical_mode = 0;
// old demographics
Q.old_demographics = 0;
// use decimals for assembly seats
// TODO: not yet implemented
Q.use_decimals = 1;

// party resources
Q.resources = 2;
// party dues
Q.dues = 2;

// the state of the party                       THE PARTY The Party The party the Party

Q.party_bureaucracy = 0;

Q.party_platform = '';

Q.riding_associations = 0;


Q.membership = 4900;
Q.membership_change = 0;
