    radical_color : "#c32222", 
    agrarian_populist_color : "#b2c520", 
    managerial_color : "#d26e28", 
    moderate_color : "#f2ff00"
};


Q.party_demographics = ['labour', 'middle class', 'agrarian', 'students'];

// Strength indicates the influence of the faction in the party
Q.agrarian_dissent = 0;
Q.agrarian_strength = 55;
Q.agrarian_radicalism = 21;

Q.middle_class_dissent = 30;
Q.middle_class_strength = 15;
