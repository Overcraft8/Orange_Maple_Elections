Q.ccf_a_relation = 50; 
Q.ccf_on_relation = 30; 
Q.ccf_nat_relation = 40

Q.ccf_wings = ['ccf_m', 'ccf_a', 'ccf_bc', 'ccf_on', 'ccf_nat']; 



// We'll let 1 be a coalition and 2 be full majority
Q.ccf_m_government = 0;
Q.ccf_bc_government = 0; 
Q.ccf_a_government = 0;
Q.ccf_on_government = 0; 
Q.ccf_nat_government = 0;



// secret events...
Q.unions_independent = 0;
Q.agrarians_resign = 0;
Q.left_split = 0;
Q.moderates_resigned = 0;

// have we discovered neorevisionism?
Q.neorevisionism = 0;

// crisis_urgency indicates how seriously the [+ ccf_ss_name +] is taking the economic crisis - scale from 0 to 10.
Q.crisis_urgency = 0;
// scps_urgency indicates how seriously the [+ ccf_ss_name +] takes the scps - scale from 0 to 10.
Q.scps_urgency = 0;
// radicalization indicates how radical the [+ ccf_ss_name +]'s rhetoric is - scale from 0 to 10.
Q.radicalization = 0;
// Support for the WTB plan and proto-Keynesian works creation plans in general
Q.wtb_support = 0;
// Support for Pacifism within the [+ ccf_ss_name +] relative to 1928
Q.pacifism = 0;
// Support for democratic reform within the [+ ccf_ss_name +] relative to 1928
Q.democratization = 0;
// Support for a communist coalition relative to 1928
Q.communist_coalition = 0;
// economic_plan: have we adopted *any* economic plan?
// 1 - WTB plan, 2 - AfA-bund plan, 3 - radical plan (mass nationalization of industries)
Q.economic_plan = 0;
