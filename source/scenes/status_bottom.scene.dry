title: General Map
new-page: true
is-special: true
on-display: {!

  var Q = window.dendryUI?.dendryEngine?.state?.qualities;

  //---------------------------------------------------------
  //                   Regional Seats                      //
  //---------------------------------------------------------

  var seatEl = document.getElementById('region_seats');
  var sceneEl = document.getElementById('region_info_display_scene');

  var data = [];
  for (var party of Q.parties) {
    var index = Q.parties.indexOf(party);
    var name = Q.parties_disp_names[index];

    data.push({
      "id": party,
      "legend": name,
      "name": name,
      "seats": Q[Q.current_region_id + '_' + party + '_seats'] || 0
    });
  }

  data = data.filter(function(p) { return p.seats > 0; });

  if (d3 && window && Q.started) {
    var screenWidth = sceneEl.offsetWidth;
    var width = Math.max(Math.min(screenWidth, 200), 90);
    var heightRatio = screenWidth < 350 ? 0.5 : 0.6;
    var height = width * heightRatio;

    seatEl.style.height = height + "px";

    var region_seats = d3.parliament();
    region_seats.width(width);
    region_seats.height(height);
    region_seats.innerRadiusCoef(0.4);
    region_seats.enter.fromCenter(false).smallToBig(false);
    region_seats.exit.toCenter(false).bigToSmall(false);
    d3.select(seatEl).datum(data).call(region_seats);
  }

  console.log("on-display");
!}

