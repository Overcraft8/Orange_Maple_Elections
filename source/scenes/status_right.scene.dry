window.news_activator();

if (document.getElementById('news_title') == null) {
  var container = document.getElementById('news_qualities'); 
  container.innerHTML += `<div style="text-align: center;" id="news_title">
                            <span style="font-family: Times New Roman; font-size: 2.2em; font-weight: bold;">News</span>
                          </div>`;
}

!}

<div style="text-align: center;" id="news_title">
  <span style="font-family: Times New Roman; font-size: 2.2em; font-weight: bold;">News</span>
</div>

[+ news_display +]
