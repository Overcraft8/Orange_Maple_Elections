title: 
new-page: true
is-special: true

= Party Hierarchy


<div style="display:flex; gap:1em; justify-content: center; text-align: center">

# <span>
# <img src="img/portraits/[+ ccf_ss_president_img +]" style="width:125px;height:170px;object-fit:cover;object-position:top;border:4px ridge #8B7355;">
#   <span class="card-caption">Party President: [+ president +] </span>
# </span>

<span>
<img src="img/portraits/[+ ccf_ss_party_leader_img +]" style="width:125px;height:170px;object-fit:cover;object-position:top;border:4px ridge #8B7355;">
  <span class="card-caption">Party Leader: [+ party_leader +]</span>
</span>

</div>

Resources available: [+ resources +]

Internal dissent: [+ dissent_percent : dissent +]

Party Bureaucracy: [+ party_bureaucracy : p_bureaucracy +]

Riding Association Strength: [+ riding_associations : p_riding_associations +]

Membership: [+ membership +]

Membership Change: [+ membership_change_trend +][+ membership_change_display +] 

</div>

@partyaffiliates

= Party Affiliates of the CCF(SS)

[? if 1 == 1 : 
<span style="color: #c32222;">**CCYM**</span> 
Influence: [+ ccym_influence +]%<br>
Relations: [+ ccym_relations : relationships +]<br>
Militancy: [+ ccym_militancy : militancy +]<br>
Strength: [+ ccym_strength +] Thousand<br>
?]

[? if ufc_affiliated = 1 :
<span style="color: #86a71b;">**UFC(SS)**</span> 
Influence: [+ ufc_influence +]%<br>
Relations: [+ ufc_relations : relationships +]<br>
Militancy: [+ ufc_militancy : militancy +]<br>
Strength: [+ ufc_strength +] Thousand<br>
?]

[? if sta_affiliated == 1 :
<span style="color: #d26e28;">**STA**</span><br>
Influence: [+ sta_influence +]%<br>
Relations: [+ sta_relations : relationships +]<br>
Militancy: [+ sta_militancy : militancy +]<br>
Strength: [+ sta_strength +] Thousand<br>
?]

[? if tlc_affiliated == 1 :
Influence: [+ tlc_influence +]%<br>
Relations: [+ tlc_relations : relationships +]<br>
Militancy: [+ tlc_militancy : militancy +]<br>
Strength: [+ tlc_strength +] Thousand<br>
?]



@partyfactions
new-page: True
is-special: True
on-arrival: {!

if (window && window.customgeneratebar) {
  window.customgeneratebar(Q.agrarian_dissent, "#466d16", "#32c732", "agrarian_bar_dissent", 'A faction consisting of farmers, primarily representing the small family farm');
  window.customgeneratebar(Q.labour_dissent, "#091f43", "#347fef", "labour_bar_dissent", 'A faction of trade unionists, middle-class professionals, and labour activists, representing the urban workers and lower middle-classes');
  window.customgeneratebar(Q.managerial_dissent, "#793f15", "#d26e28", "managerial_bar_dissent", 'The moderate wing of the CCF(SS)');
  window.customgeneratebar(Q.true_socialist_dissent, "#1f0303", "#c32222", "true_socialist_bar_dissent", 'A faction of radical socialists. Many of them have ties to Communist organizations');
 }

if (window && window.customgeneratemultibar) {
  var strengths = [];
  var factionColors = [];
/* 
  for (faction in Q.factions) {
    strengths.push(Q[faction + '_strength']);
    factionColors.push(Q.faction_colors[faction + '_color']);
  };
*/
  console.log(strengths);
  console.log(factionColors);

  var strengths = [Q.reformist_strength, Q.managerial_strength, Q.agrarian_populist_strength, Q.true_socialist_strength];
  var factionColors = ["#f2ff00", "#d26e28", "#89c520", "#c32222"];
  
  window.customgeneratemultibar(
      strengths, 
      "#333333", 
      factionColors, 
      "faction_strength_bar", 
      ['The Reformist Wing', 'The Managerial Wing', 'The Agrarian Populists', 'The True Socialist Wing']
  );
}

if (window && window.customgeneratemultibar) {
  var strengths = [Q.agrarian_strength, Q.labour_strength, Q.middle_class_strength, Q.students_strength];
  var factionColors = ["#b2c520", "#2844d2", "#22c3c0", "#e92677"];
  
  window.customgeneratemultibar(
      strengths, 
      "#333333", 
      factionColors, 
      "party_demography", 
      ['The Agrarians - Primarily Small Farmers', 'Labour - Working Class', 'Middle Class - Professionals, Civil Servants, Teachers, etc.', 'Students, many of whom are radicals']
  );
}
!}

= Faction Strength

<div id="faction_strength_bar"></div><br>

= Party Demography

<div id='party_demography'></div><br>

= Faction Dissent

<div id="agrarian_bar_dissent"></div>

<div id='labour_bar_dissent'></div>

<div id='managerial_bar_dissent'></div>

<div id='true_socialist_bar_dissent'></div><br>

Internal dissent: [+ dissent_percent : dissent +]



